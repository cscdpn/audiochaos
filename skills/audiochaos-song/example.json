{
  "version": 2,
  "description": "Example: four sections at 100 BPM in A minor. intro (2 bars): kick. verse (4): kick, bass A. chorus (4): kick, snare, bass B, lead A. outro (2): lead B and its echoes.",
  "modules": [
    {"name": "clock", "type": "clock"},
    {"name": "song", "type": "song", "sections": [{"name": "intro", "bars": 2}, {"name": "verse", "bars": 4}, {"name": "chorus", "bars": 4}, {"name": "outro", "bars": 2}], "tracks": ["A A A .", ". . A .", ". A B .", ". . A B"]},
    {"name": "kick seq", "type": "seq"},
    {"name": "snare seq", "type": "seq"},
    {"name": "bass", "type": "notes", "key": "A minor", "patterns": {"A": "A1 . A1 A2 . A1 E2 D2", "B": "F1 . F1 F2 G1 . G1 G2"}},
    {"name": "lead", "type": "notes", "key": "A minor", "patterns": {"A": "A3 - C4 . E4 - D4 C4", "B": "E4 - - - C4 - - -"}},
    {"name": "snare hits", "type": "logic"},
    {"name": "kick env", "type": "adsr"},
    {"name": "snare env", "type": "adsr"},
    {"name": "bass env", "type": "adsr"},
    {"name": "lead env", "type": "adsr"},
    {"name": "kick osc", "type": "osc"},
    {"name": "noise", "type": "noise"},
    {"name": "bass osc", "type": "osc"},
    {"name": "lead osc", "type": "osc"},
    {"name": "snare filter", "type": "filter"},
    {"name": "bass filter", "type": "filter"},
    {"name": "kick vca", "type": "vca"},
    {"name": "snare vca", "type": "vca"},
    {"name": "bass vca", "type": "vca"},
    {"name": "lead vca", "type": "vca"},
    {"name": "lead delay", "type": "delay"},
    {"name": "mix", "type": "mix"},
    {"name": "master", "type": "master"}
  ],
  "knobs": {
    "clock": {"tempo": 100.0},
    "kick seq": {"run": 0.0},
    "snare seq": {"run": 0.0, "step 1": 0.0, "step 2": 1.0, "step 3": 0.0, "step 4": 1.0, "step 5": 0.0, "step 6": 1.0, "step 7": 0.0, "step 8": 1.0},
    "kick env": {"attack": 0.001, "decay": 0.2, "sustain": 0.0, "release": 0.1},
    "snare env": {"attack": 0.001, "decay": 0.12, "sustain": 0.0, "release": 0.08},
    "bass env": {"attack": 0.003, "decay": 0.15, "sustain": 0.3, "release": 0.05},
    "lead env": {"attack": 0.005, "decay": 0.2, "sustain": 0.4, "release": 0.15},
    "kick osc": {"freq": 45.0, "fm depth": 120.0},
    "bass osc": {"freq": 261.63},
    "lead osc": {"freq": 261.63},
    "snare filter": {"cutoff": 1800.0, "resonance": 0.3},
    "bass filter": {"cutoff": 500.0, "resonance": 0.6},
    "kick vca": {"gain": 0.0},
    "snare vca": {"gain": 0.0},
    "bass vca": {"gain": 0.0},
    "lead vca": {"gain": 0.0},
    "lead delay": {"feedback": 0.45, "mix": 0.35},
    "mix": {"level 1": 1.0, "level 2": 0.5, "level 3": 0.7, "level 4": 0.35},
    "master": {"volume": 0.6}
  },
  "cables": [
    {"from": "clock", "output": "bar", "to": "song", "input": "clock"},
    {"from": "clock", "output": "beat", "to": "kick seq", "input": "clock"},
    {"from": "clock", "output": "beat", "to": "snare seq", "input": "clock"},
    {"from": "clock", "output": "8th", "to": "bass", "input": "clock"},
    {"from": "clock", "output": "8th", "to": "lead", "input": "clock"},
    {"from": "clock", "output": "dotted 8th", "to": "lead delay", "input": "clock"},
    {"from": "song", "output": "track 1", "to": "kick seq", "input": "run cv"},
    {"from": "song", "output": "track 2", "to": "snare seq", "input": "run cv"},
    {"from": "song", "output": "track 3", "to": "bass", "input": "play"},
    {"from": "song", "output": "track 4", "to": "lead", "input": "play"},
    {"from": "kick seq", "output": "gate", "to": "kick env", "input": "gate"},
    {"from": "snare seq", "output": "cv", "to": "snare hits", "input": "a"},
    {"from": "snare seq", "output": "gate", "to": "snare hits", "input": "b"},
    {"from": "snare hits", "output": "and", "to": "snare env", "input": "gate"},
    {"from": "bass", "output": "gate", "to": "bass env", "input": "gate"},
    {"from": "lead", "output": "gate", "to": "lead env", "input": "gate"},
    {"from": "kick env", "output": "env", "to": "kick osc", "input": "fm"},
    {"from": "kick osc", "output": "sine", "to": "kick vca", "input": "in"},
    {"from": "kick env", "output": "env", "to": "kick vca", "input": "mod"},
    {"from": "noise", "output": "white", "to": "snare filter", "input": "in"},
    {"from": "snare filter", "output": "bandpass", "to": "snare vca", "input": "in"},
    {"from": "snare env", "output": "env", "to": "snare vca", "input": "mod"},
    {"from": "bass", "output": "pitch", "to": "bass osc", "input": "freq cv"},
    {"from": "bass osc", "output": "saw", "to": "bass filter", "input": "in"},
    {"from": "bass filter", "output": "lowpass", "to": "bass vca", "input": "in"},
    {"from": "bass env", "output": "env", "to": "bass vca", "input": "mod"},
    {"from": "lead", "output": "pitch", "to": "lead osc", "input": "freq cv"},
    {"from": "lead osc", "output": "square", "to": "lead vca", "input": "in"},
    {"from": "lead env", "output": "env", "to": "lead vca", "input": "mod"},
    {"from": "lead vca", "output": "out", "to": "lead delay", "input": "in"},
    {"from": "kick vca", "output": "out", "to": "mix", "input": "1"},
    {"from": "snare vca", "output": "out", "to": "mix", "input": "2"},
    {"from": "bass vca", "output": "out", "to": "mix", "input": "3"},
    {"from": "lead delay", "output": "out", "to": "mix", "input": "4"},
    {"from": "mix", "output": "out", "to": "master", "input": "in"}
  ]
}
