<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <style>
        @media (prefers-color-scheme: dark) {
            body {
                background: #333;
                color: white;
            }
            a {
                color: skyblue;
            }
        }
        .container {
            font-family: sans-serif;
            max-width: 800px;
            margin: 0 auto;
        }
        .licenses-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
        }
        .license-text {
            max-height: 200px;
            overflow-y: scroll;
            white-space: pre-wrap;
        }
    </style>
    <title>audiochaos: third-party licenses</title>
</head>

<body>
    <main class="container">
        <h1>Third-party licenses</h1>
        <p>audiochaos is built on these open-source projects, under these licenses.</p>

        <h2>Overview</h2>
        <ul>
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        <h2>License texts</h2>
        <ul class="licenses-list">
            {{#each licenses}}
            <li>
                {{#if first_of_kind}}
                <h3 id="{{id}}">{{name}}</h3>
                {{/if}}
                <h4>Used by:</h4>
                <ul>
                    {{#each used_by}}
                    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
                    {{/each}}
                </ul>
                <pre class="license-text">{{text}}</pre>
            </li>
            {{/each}}
        </ul>
    </main>
</body>

</html>
