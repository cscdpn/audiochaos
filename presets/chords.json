{
  "version": 2,
  "description": "Play chords from a MIDI or the computer keyboard: four voices of saw, osc into envelope and VCA each, mixed, filtered and widened by a chorus.",
  "modules": [
    { "name": "poly", "type": "poly" },
    { "name": "osc 1", "type": "osc" },
    { "name": "env 1", "type": "adsr" },
    { "name": "vca 1", "type": "vca" },
    { "name": "osc 2", "type": "osc" },
    { "name": "env 2", "type": "adsr" },
    { "name": "vca 2", "type": "vca" },
    { "name": "osc 3", "type": "osc" },
    { "name": "env 3", "type": "adsr" },
    { "name": "vca 3", "type": "vca" },
    { "name": "osc 4", "type": "osc" },
    { "name": "env 4", "type": "adsr" },
    { "name": "vca 4", "type": "vca" },
    { "name": "mix", "type": "mix" },
    { "name": "filter", "type": "filter" },
    { "name": "chorus", "type": "chorus" },
    { "name": "master", "type": "master" }
  ],
  "knobs": {
    "osc 1": { "freq": 261.63, "fm depth": 100.0 },
    "env 1": { "attack": 0.02, "decay": 0.4, "sustain": 0.6, "release": 0.8 },
    "vca 1": { "gain": 0.0 },
    "osc 2": { "freq": 261.63, "fm depth": 100.0 },
    "env 2": { "attack": 0.02, "decay": 0.4, "sustain": 0.6, "release": 0.8 },
    "vca 2": { "gain": 0.0 },
    "osc 3": { "freq": 261.63, "fm depth": 100.0 },
    "env 3": { "attack": 0.02, "decay": 0.4, "sustain": 0.6, "release": 0.8 },
    "vca 3": { "gain": 0.0 },
    "osc 4": { "freq": 261.63, "fm depth": 100.0 },
    "env 4": { "attack": 0.02, "decay": 0.4, "sustain": 0.6, "release": 0.8 },
    "vca 4": { "gain": 0.0 },
    "mix": { "level 1": 0.35, "level 2": 0.35, "level 3": 0.35, "level 4": 0.35 },
    "filter": { "cutoff": 1800.0, "resonance": 0.25 },
    "chorus": { "rate": 0.5, "depth": 0.6, "mix": 0.5 },
    "master": { "volume": 0.6 }
  },
  "cables": [
    { "from": "poly", "output": "pitch 1", "to": "osc 1", "input": "freq cv" },
    { "from": "poly", "output": "gate 1", "to": "env 1", "input": "gate" },
    { "from": "env 1", "output": "env", "to": "vca 1", "input": "mod" },
    { "from": "osc 1", "output": "saw", "to": "vca 1", "input": "in" },
    { "from": "vca 1", "output": "out", "to": "mix", "input": "1" },
    { "from": "poly", "output": "pitch 2", "to": "osc 2", "input": "freq cv" },
    { "from": "poly", "output": "gate 2", "to": "env 2", "input": "gate" },
    { "from": "env 2", "output": "env", "to": "vca 2", "input": "mod" },
    { "from": "osc 2", "output": "saw", "to": "vca 2", "input": "in" },
    { "from": "vca 2", "output": "out", "to": "mix", "input": "2" },
    { "from": "poly", "output": "pitch 3", "to": "osc 3", "input": "freq cv" },
    { "from": "poly", "output": "gate 3", "to": "env 3", "input": "gate" },
    { "from": "env 3", "output": "env", "to": "vca 3", "input": "mod" },
    { "from": "osc 3", "output": "saw", "to": "vca 3", "input": "in" },
    { "from": "vca 3", "output": "out", "to": "mix", "input": "3" },
    { "from": "poly", "output": "pitch 4", "to": "osc 4", "input": "freq cv" },
    { "from": "poly", "output": "gate 4", "to": "env 4", "input": "gate" },
    { "from": "env 4", "output": "env", "to": "vca 4", "input": "mod" },
    { "from": "osc 4", "output": "saw", "to": "vca 4", "input": "in" },
    { "from": "vca 4", "output": "out", "to": "mix", "input": "4" },
    { "from": "mix", "output": "out", "to": "filter", "input": "in" },
    { "from": "filter", "output": "lowpass", "to": "chorus", "input": "in" },
    { "from": "chorus", "output": "out", "to": "master", "input": "in" }
  ]
}
